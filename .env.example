# PlanA (dieta-app). Copie para .env.local e preencha.
# Variável vazia é inválida: para usar o padrão, REMOVA a linha.

# Banco de dados: o MESMO MySQL 8 do v0-tami-forms (que cria as tabelas).
DATABASE_URL=mysql://user:pass@host:3306/tami_forms

# Segredo que assina o cookie de sessão (mínimo 32 caracteres, aleatório).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres

# Endereço público deste app (vai no link de "esqueci a senha").
APP_URL=https://plana.nutritamilivalle.com.br

# Endereço do v0-tami-forms, de onde saem os e-mails e WhatsApps.
# No Easypanel use a URL interna do serviço.
FORMS_INTERNAL_URL=http://localhost:5000

# O MESMO valor do JOBS_TOKEN do v0-tami-forms (mínimo 32 caracteres).
JOBS_TOKEN=troque-pelo-mesmo-jobs-token-do-v0-tami-forms

# Primeiro admin: criado no boot se a tabela admins estiver vazia.
# Depois que existe algum admin, estas variáveis são ignoradas (mudar a senha aqui não troca a senha).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-por-uma-senha-com-12-ou-mais-caracteres
ADMIN_NAME=Administrador

# Canais da recuperação de senha. Devem ter os mesmos valores do v0-tami-forms.
NOTIFY_EMAIL_ENABLED=true
NOTIFY_WHATSAPP_ENABLED=true
